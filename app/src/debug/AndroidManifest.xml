<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Debug-only. This file is merged into the debug manifest and into nothing
      else, so the receiver below and the generator it calls are absent from the
      release APK rather than present-but-disabled.

      Still no <uses-permission>, here or anywhere: FR-APP-01's offline-only
      guarantee is verified against the merged manifest, and a debug-only
      permission would show up in the debug one.
    -->
    <application>

        <!--
          Seeding: the exact command is in SeedReceiver's KDoc and in
          CLAUDE.md. It cannot be reproduced here, because it needs a
          double-hyphen flag and XML comments may not contain one.

          Puts five years of data on the device so NFR-PERF-04's 300 ms can be
          measured against the workload M4's exit criterion names.

          Not exported, and the `run-as` prefix that command carries is not a
          workaround for that — it is the consequence of it. The shell uid
          cannot deliver to a non-exported receiver in another package, and the
          rejection is silent: the broadcast is enqueued, the receiver never
          runs, nothing logs an error. `run-as` sends from inside the package
          instead. This comment used to claim the plain shell form worked; it
          does not, and finding that out cost a day (CLAUDE.md, traps; 06 §30.2).
        -->
        <receiver
            android:name="com.app.finance.dev.SeedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.app.finance.SEED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
