<?xml version="1.0" encoding="utf-8"?>
<!--
  A platform theme, not a Material Components one. Pulling in
  com.google.android.material solely to parent an XML style would cost several
  hundred KB against the 6 MB ceiling for a file the app renders past in one
  frame. Everything visual belongs to Compose.

  windowBackground is set to `paper` on purpose: it is what fills the window
  between process start and the first composed frame. Left at the platform
  default it flashes white, which reads as a stall on exactly the cold start
  NFR-PERF-01 budgets at 800 ms.
-->
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Khata" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:navigationBarColor">@color/paper</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>
</resources>
